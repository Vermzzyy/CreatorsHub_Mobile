<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header bar (matches the app's dark navy theme) -->
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/primary_dark"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Services"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/searchField"
            android:hint="Search a service..."
            android:padding="10dp"
            android:background="@drawable/input_field"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Category chips -->
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/chipAll"
                    android:text="All"
                    android:textColor="@color/white"
                    android:background="@drawable/primary_button"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/chipUiUx"
                    android:text="UI/UX"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/input_field"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/chipGameDev"
                    android:text="Game Dev"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/input_field"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/chipGraphicDesign"
                    android:text="Graphic Design"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/input_field"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Content area: FrameLayout so the progress spinner can overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Services grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/servicesRecycler"
            android:padding="10dp"
            android:clipToPadding="false"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Loading spinner (centred overlay) -->
        <ProgressBar
            android:id="@+id/servicesProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <!-- Empty / error state -->
        <LinearLayout
            android:id="@+id/servicesEmptyContainer"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/servicesEmpty"
                android:text="No services available"
                android:textAlignment="center"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </FrameLayout>

    <include layout="@layout/bottom_navbar"/>

</LinearLayout>